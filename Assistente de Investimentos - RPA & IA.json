        "jsCode": "const cliente = $('Webhook (Entrada)').first().json.body;\nconst csvData = $input.first().json.data;\n\n// Mapeamento simples de opções por perfil\nlet recomendacao = \"Renda Fixa / Tesouro Direto\";\nif (cliente.perfil.toLowerCase().includes('moderado')) {\n  recomendacao = \"Fundos Imobiliários e CDE\";\n} else if (cliente.perfil.toLowerCase().includes('arrojado')) {\n  recomendacao = \"Ações e ETFs de Crescimento\";\n}\n\nreturn {\n  json: {\n    nome: cliente.nome,\n    email: cliente.email,\n    saldo: cliente.saldo,\n    perfil: cliente.perfil,\n    investimento_sugerido: recomendacao,\n    mensagem_personalizada: `Olá ${cliente.nome}! Identificamos seu perfil como ${cliente.perfil}. Com base no seu saldo disponível de ${cliente.saldo}, recomendamos a opção: ${recomendacao}.`\n  }\n};"
